# Base URL of the GymCrush API as reachable from the device/simulator.
# iOS simulator can use localhost; Android emulator uses 10.0.2.2;
# a physical device needs your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Local dev only: auto-sign-in with the seeded dev account (dev@gymcrush.app)
# so you skip the login screen. Requires `pnpm db:seed` to have run.
# EXPO_PUBLIC_DEV_LOGIN=1
