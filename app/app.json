{
  "expo": {
    "name": "GymCrush",
    "slug": "gymcrush",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gymcrush",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#ccff00"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymcrush.app"
    },
    "android": {
      "package": "com.gymcrush.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c58ac295-66af-4e1e-9ca6-7b8286d31cf2"
      }
    },
    "owner": "kudo-io"
  }
}
