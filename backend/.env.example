# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymcrush?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT secrets — generate strong random values for production
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Seeded local dev account (created by `pnpm db:seed`; local dev only).
# The app's dev auto-login (EXPO_PUBLIC_DEV_LOGIN=1) signs in with these.
#   dev@gymcrush.app / devpassword123
