# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymcrush?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT secrets — generate strong random values for production
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Supabase Auth.
# SUPABASE_URL is the public project URL (it also ships in the app bundle).
# Leave these unset to keep using legacy JWT auth — the API degrades gracefully.
SUPABASE_URL="https://<project-ref>.supabase.co"
# SERVER-ONLY. Bypasses all row security — never prefix with EXPO_PUBLIC_ and
# never put it in app/eas.json. Needed for account deletion + the user import.
SUPABASE_SERVICE_ROLE_KEY=""

# Comma-separated CORS allowlist (e.g. "https://app.example.com").
# Unset = reflect any origin, which is fine for local dev only.
CORS_ORIGINS=""

# Seeded local dev account (created by `pnpm db:seed`; local dev only).
# The app's dev auto-login (EXPO_PUBLIC_DEV_LOGIN=1) signs in with these.
#   dev@gymcrush.app / devpassword123
