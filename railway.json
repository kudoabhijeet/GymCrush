{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksVersion": "1.29.1",
    "buildCommand": "pnpm build:shared && pnpm --filter @gymcrush/backend prisma generate && pnpm --filter @gymcrush/backend build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @gymcrush/backend start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
