{
  "name": "gymcrush",
  "version": "0.1.0",
  "private": true,
  "description": "GymCrush — a power-user gym app: workout plans, logging, and macro tracking with a rich UI/UX.",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "app": "pnpm --filter @gymcrush/app",
    "backend": "pnpm --filter @gymcrush/backend",
    "shared": "pnpm --filter @gymcrush/shared",
    "dev:app": "pnpm --filter @gymcrush/app start",
    "dev:backend": "pnpm --filter @gymcrush/backend dev",
    "build:shared": "pnpm --filter @gymcrush/shared build",
    "db:migrate": "pnpm --filter @gymcrush/backend prisma migrate dev",
    "db:seed": "pnpm --filter @gymcrush/backend db:seed",
    "db:seed:demo": "pnpm --filter @gymcrush/backend db:seed:demo",
    "db:studio": "pnpm --filter @gymcrush/backend prisma studio",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --no-bail test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
